<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>io.loomvault</groupId>
    <artifactId>loomvault-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>LoomVault</name>
    <description>Durable execution engine for AI agent workflows — replayable, resumable, budget-aware.</description>
    <url>https://github.com/loomvault/loomvault</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>loomvault-core</module>
        <module>loomvault-llm</module>
        <module>loomvault-store</module>
        <module>loomvault-server</module>
    </modules>

    <properties>
        <!-- Toolchain: LoomVault targets Java 21 (virtual threads, records, pattern matching). -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Test dependency versions not covered by spring-boot-dependencies -->
        <assertj.version>3.27.3</assertj.version>
        <awaitility.version>4.3.0</awaitility.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules, version-locked to the reactor build -->
            <dependency>
                <groupId>io.loomvault</groupId>
                <artifactId>loomvault-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.loomvault</groupId>
                <artifactId>loomvault-llm</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.loomvault</groupId>
                <artifactId>loomvault-store</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.loomvault</groupId>
                <artifactId>loomvault-server</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Virtual-thread friendly: give tests a generous timeout budget -->
                        <forkCount>1</forkCount>
                        <reuseForks>true</reuseForks>
                        <argLine>-Xmx512m -XX:+EnableDynamicAgentLoading</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <argLine>-Xmx512m</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
